
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Smart Productivity System</title>

<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

<style>
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: 'Poppins', sans-serif;
}

body {
    background: #100e20;
    color: white;
}

.app {
    display: flex;
    min-height: 100vh;
}

/* SIDEBAR */

.sidebar {
    width: 250px;
    background: #19152d;
    padding: 25px 18px;
    position: fixed;
    height: 100vh;
    overflow-y: auto;
    border-right: 1px solid #33294a;
}

.logo {
    font-size: 21px;
    font-weight: 700;
    margin-bottom: 35px;
    color: #ff77b7;
}

.logo i {
    margin-right: 9px;
}

.nav-title {
    font-size: 11px;
    color: #89819f;
    margin: 20px 10px 10px;
    letter-spacing: 1px;
}

.sidebar a {
    display: flex;
    align-items: center;
    gap: 13px;
    color: #bcb5d0;
    padding: 12px;
    margin-bottom: 6px;
    border-radius: 10px;
    cursor: pointer;
    text-decoration: none;
    font-size: 13px;
    transition: .3s;
}

.sidebar a:hover,
.sidebar a.active {
    background: linear-gradient(90deg, #a34bba, #ed579e);
    color: white;
}

.sidebar a i {
    width: 20px;
}

/* MAIN */

.main {
    margin-left: 250px;
    width: calc(100% - 250px);
    padding: 30px;
}

.topbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 30px;
    gap: 15px;
}

.topbar h2 {
    font-size: 23px;
}

.topbar p {
    color: #a9a0bd;
    font-size: 12px;
}

.profile {
    display: flex;
    align-items: center;
    gap: 12px;
}

.avatar {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: linear-gradient(135deg, #ff77b7, #9473ff);
    display: grid;
    place-items: center;
    font-weight: bold;
}

.page {
    display: none;
}

.page.active {
    display: block;
}

.heading {
    margin-bottom: 22px;
}

.heading h2 {
    font-size: 25px;
    margin-bottom: 6px;
}

.heading p {
    color: #a9a0bd;
    font-size: 13px;
}

/* DASHBOARD CARDS */

.cards {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
    margin-bottom: 25px;
}

.card {
    background: linear-gradient(140deg, #28203e, #1b1930);
    padding: 22px;
    border: 1px solid #3c3051;
    border-radius: 17px;
    transition: .3s;
}

.card:hover {
    transform: translateY(-5px);
}

.card i {
    color: #ff77b7;
    font-size: 23px;
    margin-bottom: 15px;
}

.card h3 {
    font-size: 27px;
}

.card p {
    font-size: 12px;
    color: #aaa0bd;
}

.content-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 20px;
}

.panel {
    background: #1c1830;
    border: 1px solid #39304e;
    border-radius: 17px;
    padding: 23px;
    margin-bottom: 20px;
}

.panel h3 {
    font-size: 17px;
    margin-bottom: 18px;
}

.progress {
    background: #393047;
    height: 9px;
    border-radius: 20px;
    overflow: hidden;
    margin: 15px 0;
}

.progress-bar {
    height: 100%;
    background: linear-gradient(90deg, #ff77b7, #9577ff);
    border-radius: 20px;
}

/* BUTTONS AND INPUTS */

button {
    cursor: pointer;
    border: none;
    font-family: inherit;
}

.primary-btn {
    background: linear-gradient(90deg, #e957a7, #936bfa);
    color: white;
    padding: 11px 18px;
    border-radius: 9px;
    font-size: 12px;
    font-weight: 600;
}

input, textarea, select {
    background: #29233d;
    border: 1px solid #453957;
    color: white;
    padding: 12px;
    border-radius: 9px;
    width: 100%;
    outline: none;
    margin: 8px 0 14px;
}

input:focus, textarea:focus, select:focus {
    border-color: #e957a7;
}

label {
    font-size: 12px;
    color: #c9bfd8;
}

.form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
}

/* TASKS */

.task-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: #29233d;
    padding: 14px;
    border-radius: 10px;
    margin-bottom: 10px;
    gap: 10px;
}

.task-item.done .task-name {
    text-decoration: line-through;
    opacity: .5;
}

.task-left {
    display: flex;
    align-items: center;
    gap: 10px;
}

.task-name {
    font-size: 13px;
}

.task-meta {
    font-size: 10px;
    color: #aaa0bd;
}

.delete {
    color: #ff6c91;
    background: none;
    padding: 7px;
}

/* HABITS */

.habit-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px;
    background: #29233d;
    margin-bottom: 12px;
    border-radius: 10px;
}

.habit-item p {
    font-size: 13px;
}

.habit-item small {
    color: #aaa0bd;
}

.habit-item button {
    background: #49304f;
    color: #ff91c6;
    padding: 9px 13px;
    border-radius: 8px;
}

/* FOCUS TIMER */

.timer {
    text-align: center;
    padding: 45px 15px;
}

.timer h1 {
    font-size: 65px;
    color: #ff80ba;
    margin: 20px 0;
}

.timer button {
    margin: 5px;
}

/* CALENDAR */

.calendar-grid {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 8px;
    text-align: center;
}

.calendar-grid div {
    padding: 13px 4px;
    background: #29233d;
    border-radius: 8px;
    font-size: 12px;
}

.calendar-grid .today {
    background: linear-gradient(135deg, #e957a7, #936bfa);
}

/* JOURNAL */

textarea {
    min-height: 160px;
    resize: vertical;
}

/* FOOTER */

footer {
    text-align: center;
    padding: 25px;
    color: #817891;
    font-size: 11px;
}

/* RESPONSIVE */

@media(max-width: 1050px) {
    .cards {
        grid-template-columns: repeat(2, 1fr);
    }
}

@media(max-width: 750px) {
    .sidebar {
        width: 70px;
        padding: 20px 8px;
    }

    .logo {
        font-size: 0;
        text-align: center;
    }

    .logo i {
        font-size: 23px;
    }

    .sidebar a {
        justify-content: center;
        font-size: 0;
        padding: 14px 5px;
    }

    .sidebar a i {
        font-size: 17px;
    }

    .nav-title {
        display: none;
    }

    .main {
        margin-left: 70px;
        width: calc(100% - 70px);
        padding: 17px;
    }

    .content-grid {
        grid-template-columns: 1fr;
    }

    .topbar h2 {
        font-size: 16px;
    }
}

@media(max-width: 450px) {
    .cards {
        grid-template-columns: 1fr 1fr;
        gap: 10px;
    }

    .card {
        padding: 14px;
    }

    .card h3 {
        font-size: 21px;
    }

    .form-row {
        grid-template-columns: 1fr;
        gap: 0;
    }

    .timer h1 {
        font-size: 45px;
    }
}
</style>
</head>

<body>

<div class="app">

<!-- SIDEBAR NAVIGATION -->

<aside class="sidebar">

    <div class="logo">
        <i class="fas fa-bolt"></i> SMART FLOW
    </div>

    <p class="nav-title">MAIN MENU</p>

    <a class="active" onclick="showPage('dashboard',this)">
        <i class="fas fa-house"></i> Dashboard
    </a>

    <a onclick="showPage('tasks',this)">
        <i class="fas fa-list-check"></i> Tasks
    </a>

    <a onclick="showPage('calendar',this)">
        <i class="fas fa-calendar"></i> Calendar
    </a>

    <a onclick="showPage('goals',this)">
        <i class="fas fa-bullseye"></i> Goals
    </a>

    <a onclick="showPage('habits',this)">
        <i class="fas fa-repeat"></i> Habits
    </a>

    <p class="nav-title">PRODUCTIVITY</p>

    <a onclick="showPage('planner',this)">
        <i class="fas fa-clipboard-list"></i> Daily Planner
    </a>

    <a onclick="showPage('focus',this)">
        <i class="fas fa-clock"></i> Focus Mode
    </a>

    <a onclick="showPage('journal',this)">
        <i class="fas fa-book"></i> Journal
    </a>

    <a onclick="showPage('analytics',this)">
        <i class="fas fa-chart-line"></i> Analytics
    </a>

    <p class="nav-title">ACCOUNT</p>

    <a onclick="showPage('settings',this)">
        <i class="fas fa-gear"></i> Settings
    </a>

</aside>

<!-- MAIN CONTENT -->

<main class="main">

<header class="topbar">
    <div>
        <h2 id="welcome">Welcome Back! 👋</h2>
        <p id="todayDate"></p>
    </div>

    <div class="profile">
        <div class="avatar">U</div>
        <div>
            <b style="font-size:12px">My Profile</b>
            <p style="font-size:10px;color:#aaa">Productivity User</p>
        </div>
    </div>
</header>

<!-- DASHBOARD -->

<section class="page active" id="dashboard">

    <div class="heading">
        <h2>Your Productivity Dashboard</h2>
        <p>Plan your day. Focus on your goals. Celebrate your progress.</p>
    </div>

    <div class="cards">

        <div class="card">
            <i class="fas fa-list-check"></i>
            <h3 id="totalTasks">0</h3>
            <p>Total Tasks</p>
        </div>

        <div class="card">
            <i class="fas fa-circle-check"></i>
            <h3 id="completedTasks">0</h3>
            <p>Completed Tasks</p>
        </div>

        <div class="card">
            <i class="fas fa-bullseye"></i>
            <h3 id="totalGoals">0</h3>
            <p>Active Goals</p>
        </div>

        <div class="card">
            <i class="fas fa-fire"></i>
            <h3 id="totalHabits">0</h3>
            <p>Tracked Habits</p>
        </div>

    </div>

    <div class="content-grid">

        <div class="panel">
            <h3>Today's Progress</h3>
            <p style="font-size:13px;color:#aaa">Task completion</p>

            <div class="progress">
                <div class="progress-bar" id="progressBar"
                     style="width:0%"></div>
            </div>

            <h2 id="progressText">0%</h2>
            <p style="font-size:12px;color:#aaa">
                Keep going! Every small step matters.
            </p>
        </div>

        <div class="panel">
            <h3>Quick Actions</h3>

            <button class="primary-btn"
              onclick="showPage('tasks')">
              + Add Task
            </button>

            <button class="primary-btn"
              onclick="showPage('habits')">
              + Add Habit
            </button>

            <button class="primary-btn"
              onclick="showPage('focus')">
              Start Focus
            </button>
        </div>

    </div>

    <div class="panel">
        <h3>Today's Tasks</h3>
        <div id="dashboardTasks"></div>
    </div>

</section>

<!-- TASK MANAGER -->

<section class="page" id="tasks">

    <div class="heading">
        <h2>Task Management 📝</h2>
        <p>Organize your tasks and complete them on time.</p>
    </div>

    <div class="panel">

        <h3>Create New Task</h3>

        <label>Task Title</label>
        <input id="taskTitle" placeholder="Enter task name">

        <div class="form-row">
            <div>
                <label>Priority</label>
                <select id="taskPriority">
                    <option>High</option>
                    <option>Medium</option>
                    <option>Low</option>
                </select>
            </div>

            <div>
                <label>Due Date</label>
                <input type="date" id="taskDate">
            </div>
        </div>

        <button class="primary-btn" onclick="addTask()">
            Add Task +
        </button>

    </div>

    <div class="panel">
        <h3>My Tasks</h3>
        <div id="taskList"></div>
    </div>

</section>

<!-- CALENDAR -->

<section class="page" id="calendar">

    <div class="heading">
        <h2>My Calendar 📅</h2>
        <p>Check your current month and today's date.</p>
    </div>

    <div class="panel">
        <h3 id="monthTitle"></h3>
        <div class="calendar-grid" id="calendarGrid"></div>
    </div>

</section>

<!-- GOALS -->

<section class="page" id="goals">

    <div class="heading">
        <h2>My Goals 🎯</h2>
        <p>Set your goals and work towards success.</p>
    </div>

    <div class="panel">
        <h3>Create a Goal</h3>

        <label>Goal Name</label>
        <input id="goalName" placeholder="Enter your goal">

        <label>Target Date</label>
        <input id="goalDate" type="date">

        <button class="primary-btn" onclick="addGoal()">
            Add Goal +
        </button>
    </div>

    <div class="panel">
        <h3>My Goals List</h3>
        <div id="goalList"></div>
    </div>

</section>

<!-- HABITS -->

<section class="page" id="habits">

    <div class="heading">
        <h2>Habit Tracker 🔥</h2>
        <p>Build good habits and improve every day.</p>
    </div>

    <div class="panel">
        <h3>Add New Habit</h3>

        <input id="habitName" placeholder="Example: Read for 30 minutes">

        <button class="primary-btn" onclick="addHabit()">
            Add Habit +
        </button>
    </div>

    <div class="panel">
        <h3>Daily Habits</h3>
        <div id="habitList"></div>
    </div>

</section>

<!-- DAILY PLANNER -->

<section class="page" id="planner">

    <div class="heading">
        <h2>Daily Planner 📋</h2>
        <p>Write your schedule and plan your day.</p>
    </div>

    <div class="panel">

        <h3>My Daily Plan</h3>

        <label>Select Date</label>
        <input type="date" id="plannerDate">

        <label>Today's Schedule</label>
        <textarea id="plannerText"
        placeholder="9:00 AM - Study&#10;11:00 AM - Project Work&#10;2:00 PM - Practice Coding"></textarea>

        <button class="primary-btn" onclick="savePlanner()">
            Save My Plan
        </button>

        <p id="plannerMessage"
           style="margin-top:12px;color:#ff80ba;font-size:12px"></p>

    </div>

</section>

<!-- FOCUS MODE -->

<section class="page" id="focus">

    <div class="heading">
        <h2>Focus Mode ⏳</h2>
        <p>Stay focused and avoid distractions.</p>
    </div>

    <div class="panel timer">

        <h3>Focus Session</h3>

        <div>
            <input type="number" id="focusMinutes"
             value="25" min="1" max="180"
             style="width:100px;text-align:center">
            <p style="color:#aaa;font-size:12px">
                Set time in minutes
            </p>
        </div>

        <h1 id="timerDisplay">25:00</h1>

        <button class="primary-btn" onclick="startTimer()">
            <i class="fas fa-play"></i> Start
        </button>

        <button class="primary-btn" onclick="pauseTimer()">
            <i class="fas fa-pause"></i> Pause
        </button>

        <button class="primary-btn" onclick="resetTimer()">
            <i class="fas fa-rotate"></i> Reset
        </button>

        <p id="timerMessage"
           style="margin-top:20px;color:#ff80ba">
           Ready to focus?
        </p>

    </div>

</section>

<!-- JOURNAL -->

<section class="page" id="journal">

    <div class="heading">
        <h2>My Journal 📖</h2>
        <p>Write your thoughts and reflect on your day.</p>
    </div>

    <div class="panel">

        <label>Journal Date</label>
        <input type="date" id="journalDate">

        <label>Today's Thoughts</label>
        <textarea id="journalText"
        placeholder="Write about your day..."></textarea>

        <button class="primary-btn" onclick="saveJournal()">
            Save Journal
        </button>

        <div id="journalMessage"
             style="color:#ff80ba;margin-top:12px;font-size:12px"></div>

    </div>

</section>

<!-- ANALYTICS -->

<section class="page" id="analytics">

    <div class="heading">
        <h2>Productivity Analytics 📊</h2>
        <p>Understand your progress and performance.</p>
    </div>

    <div class="cards">

        <div class="card">
            <i class="fas fa-tasks"></i>
            <h3 id="analyticsTotal">0</h3>
            <p>Total Tasks</p>
        </div>

        <div class="card">
            <i class="fas fa-check-circle"></i>
            <h3 id="analyticsCompleted">0</h3>
            <p>Completed</p>
        </div>

    </div>

    <div class="panel">
        <h3>Task Completion Rate</h3>

        <div class="progress">
            <div class="progress-bar"
                 id="analyticsBar" style="width:0%">
            </div>
        </div>

        <h2 id="analyticsRate">0%</h2>

        <p style="font-size:12px;color:#aaa">
            Your overall task completion percentage.
        </p>
    </div>

</section>

<!-- SETTINGS -->

<section class="page" id="settings">

    <div class="heading">
        <h2>Settings ⚙️</h2>
        <p>Manage your profile information.</p>
    </div>

    <div class="panel">

        <h3>My Profile</h3>

        <label>Your Name</label>
        <input id="userName" placeholder="Enter your name">

        <label>Email Address</label>
        <input id="userEmail" type="email"
               placeholder="Enter your email">

        <button class="primary-btn" onclick="saveProfile()">
            Save Profile
        </button>

        <p id="profileMessage"
           style="color:#ff80ba;margin-top:12px;font-size:12px">
        </p>

    </div>

    <div class="panel">
        <h3>Application Information</h3>
        <p style="color:#aaa;font-size:13px">
            Smart Productivity System<br>
            Version 1.0<br>
            Developed for personal and professional
            task management.
        </p>
    </div>

</section>

<footer>
    © 2026 Smart Productivity System | Manage Your Time Smartly 💜
</footer>

</main>
</div>

<script>
/* GENERAL HELPERS */

const $ = id => document.getElementById(id);

function readData(key, fallback) {
    try {
        const value = JSON.parse(localStorage.getItem(key));
        return value === null ? fallback : value;
    } catch {
        return fallback;
    }
}

let tasks = readData("sp_tasks", []);
let habits = readData("sp_habits", []);
let goals = readData("sp_goals", []);

function saveData(key, data) {
    localStorage.setItem(key, JSON.stringify(data));
}

/* NAVIGATION */

function showPage(page, element) {
    document.querySelectorAll(".page").forEach(p => {
        p.classList.remove("active");
    });

    $(page).classList.add("active");

    document.querySelectorAll(".sidebar a").forEach(a => {
        a.classList.remove("active");
    });

    if (element) {
        element.classList.add("active");
    } else {
        document.querySelectorAll(".sidebar a").forEach(a => {
            if (a.getAttribute("onclick")?.includes(
                "'" + page + "'")) {
                a.classList.add("active");
            }
        });
    }

    const titles = {
        dashboard: "Welcome Back! 👋",
        tasks: "Task Management",
        calendar: "My Calendar",
        goals: "My Goals",
        habits: "Habit Tracker",
        planner: "Daily Planner",
        focus: "Focus Mode",
        journal: "My Journal",
        analytics: "Analytics",
        settings: "Settings"
    };

    $("welcome").textContent = titles[page];
    renderAll();
}

/* DATE */

const now = new Date();
$("todayDate").textContent = now.toDateString();

const today = () => {
    const d = new Date();
    return d.getFullYear() + "-" +
        String(d.getMonth()+1).padStart(2,"0") + "-" +
        String(d.getDate()).padStart(2,"0");
};

$("taskDate").value = today();
$("plannerDate").value = today();
$("journalDate").value = today();

/* TASK MANAGEMENT */

function addTask() {
    const title = $("taskTitle").value.trim();

    if (!title) {
        alert("Please enter a task name!");
        return;
    }

    tasks.push({
        id: Date.now(),
        title: title,
        priority: $("taskPriority").value,
        date: $("taskDate").value,
        done: false
    });

    saveData("sp_tasks", tasks);

    $("taskTitle").value = "";

    renderAll();
}

function toggleTask(id) {
    tasks = tasks.map(t =>
        t.id === id ? {...t, done: !t.done} : t
    );

    saveData("sp_tasks", tasks);
    renderAll();
}

function deleteTask(id) {
    tasks = tasks.filter(t => t.id !== id);
    saveData("sp_tasks", tasks);
    renderAll();
}

function taskHTML(t) {
    return `
    <div class="task-item ${t.done ? "done" : ""}">
        <div class="task-left">
            <input type="checkbox"
                ${t.done ? "checked" : ""}
                onchange="toggleTask(${t.id})"
                style="width:auto;margin:0">

            <div>
                <div class="task-name">${escapeHTML(t.title)}</div>
                <div class="task-meta">
                    ${escapeHTML(t.priority)} Priority ·
                    ${escapeHTML(t.date || "No date")}
                </div>
            </div>
        </div>

        <button class="delete"
            onclick="deleteTask(${t.id})">
            <i class="fas fa-trash"></i>
        </button>
    </div>`;
}

function renderTasks() {
    $("taskList").innerHTML =
        tasks.length
        ? tasks.map(taskHTML).join("")
        : "<p style='color:#aaa;font-size:13px'>No tasks added yet.</p>";

    const todayTasks = tasks.filter(t => t.date === today());

    $("dashboardTasks").innerHTML =
        todayTasks.length
        ? todayTasks.map(taskHTML).join("")
        : "<p style='color:#aaa;font-size:13px'>No tasks scheduled for today.</p>";
}

/* HABIT TRACKER */

function addHabit() {
    const name = $("habitName").value.trim();

    if (!name) {
        alert("Enter a habit name!");
        return;
    }

    habits.push({
        id: Date.now(),
        name,
        done: false,
        lastDone: ""
    });

    $("habitName").value = "";
    saveData("sp_habits", habits);
    renderAll();
}

function toggleHabit(id) {
    habits = habits.map(h => {
        if (h.id === id) {
            const alreadyDone = h.lastDone === today();

            return {
                ...h,
                done: !alreadyDone,
                lastDone: alreadyDone ? "" : today()
            };
        }
        return h;
    });

    saveData("sp_habits", habits);
    renderAll();
}

function renderHabits() {
    $("habitList").innerHTML = habits.length
    ? habits.map(h => {
        const done = h.lastDone === today();

        return `
        <div class="habit-item">
            <div>
                <p>${escapeHTML(h.name)}</p>
                <small>${done ? "Completed today ✓" : "Not completed today"}</small>
            </div>
            <button onclick="toggleHabit(${h.id})">
                ${done ? "Undo" : "Done ✓"}
            </button>
        </div>`;
    }).join("")
    : "<p style='color:#aaa;font-size:13px'>Add your first habit!</p>";
}

/* GOALS */

function addGoal() {
    const name = $("goalName").value.trim();

    if (!name) {
        alert("Enter a goal!");
        return;
    }

    goals.push({
        id: Date.now(),
        name,
        date: $("goalDate").value
    });

    $("goalName").value = "";
    saveData("sp_goals", goals);
    renderAll();
}

function deleteGoal(id) {
    goals = goals.filter(g => g.id !== id);
    saveData("sp_goals", goals);
    renderAll();
}

function renderGoals() {
    $("goalList").innerHTML = goals.length
    ? goals.map(g => `
        <div class="task-item">
            <div>
                <p>${escapeHTML(g.name)}</p>
                <small class="task-meta">
                    Target: ${escapeHTML(g.date || "Not set")}
                </small>
            </div>
            <button class="delete"
                onclick="deleteGoal(${g.id})">
                <i class="fas fa-trash"></i>
            </button>
        </div>
    `).join("")
    : "<p style='color:#aaa;font-size:13px'>No goals added yet.</p>";
}

/* DASHBOARD AND ANALYTICS */

function renderStats() {
    const total = tasks.length;
    const completed = tasks.filter(t => t.done).length;
    const percent = total ? Math.round(completed / total * 100) : 0;

    $("totalTasks").textContent = total;
    $("completedTasks").textContent = completed;
    $("totalGoals").textContent = goals.length;
    $("totalHabits").textContent = habits.length;

    $("progressBar").style.width = percent + "%";
    $("progressText").textContent = percent + "%";

    $("analyticsTotal").textContent = total;
    $("analyticsCompleted").textContent = completed;
    $("analyticsBar").style.width = percent + "%";
    $("analyticsRate").textContent = percent + "%";
}

/* CALENDAR */

function renderCalendar() {
    const year = now.getFullYear();
    const month = now.getMonth();

    $("monthTitle").textContent =
        now.toLocaleString("default", {
            month: "long",
            year: "numeric"
        });

    const firstDay = new Date(year, month, 1).getDay();
    const days = new Date(year, month + 1, 0).getDate();

    const names = ["Sun","Mon","Tue","Wed","Thu","Fri","Sat"];

    let html = names.map(n => `<div>${n}</div>`).join("");

    for (let i = 0; i < firstDay; i++) {
        html += "<div></div>";
    }

    for (let day = 1; day <= days; day++) {
        const isToday = day === now.getDate();

        html += `<div class="${isToday ? "today" : ""}">${day}</div>`;
    }

    $("calendarGrid").innerHTML = html;
}

/* DAILY PLANNER */

function savePlanner() {
    const date = $("plannerDate").value;
    const text = $("plannerText").value;

    if (!date) {
        alert("Choose a date!");
        return;
    }

    const plans = readData("sp_plans", {});
    plans[date] = text;

    saveData("sp_plans", plans);
    $("plannerMessage").textContent = "Your plan has been saved!";
}

$("plannerDate").addEventListener("change", () => {
    const plans = readData("sp_plans", {});
    $("plannerText").value = plans[$("plannerDate").value] || "";
});

/* JOURNAL */

function saveJournal() {
    const date = $("journalDate").value;
    const text = $("journalText").value;

    if (!date || !text.trim()) {
        alert("Enter your journal details!");
        return;
    }

    const journal = readData("sp_journal", {});
    journal[date] = text;

    saveData("sp_journal", journal);
    $("journalMessage").textContent =
        "Journal saved successfully!";
}

$("journalDate").addEventListener("change", () => {
    const journal = readData("sp_journal", {});
    $("journalText").value = journal[$("journalDate").value] || "";
});

/* FOCUS TIMER */

let remaining = 25 * 60;
let timerInterval = null;

function updateTimer() {
    const min = Math.floor(remaining / 60);
    const sec = remaining % 60;

    $("timerDisplay").textContent =
        String(min).padStart(2,"0") + ":" +
        String(sec).padStart(2,"0");
}

function startTimer() {
    if (timerInterval) return;

    if (remaining <= 0) {
        remaining = Math.max(1, Number($("focusMinutes").value) || 25) * 60;
    }

    $("timerMessage").textContent = "Focus session running...";

    timerInterval = setInterval(() => {
        remaining--;
        updateTimer();

        if (remaining <= 0) {
            clearInterval(timerInterval);
            timerInterval = null;
            $("timerMessage").textContent =
                "🎉 Great work! Focus session completed!";
            alert("Focus session completed!");
        }
    }, 1000);
}

function pauseTimer() {
    clearInterval(timerInterval);
    timerInterval = null;
    $("timerMessage").textContent = "Timer paused.";
}

function resetTimer() {
    clearInterval(timerInterval);
    timerInterval = null;

    remaining = Math.max(1, Number($("focusMinutes").value) || 25) * 60;

    updateTimer();
    $("timerMessage").textContent = "Timer reset.";
}

$("focusMinutes").addEventListener("change", () => {
    if (!timerInterval) resetTimer();
});

/* PROFILE */

function saveProfile() {
    const name = $("userName").value.trim();
    const email = $("userEmail").value.trim();

    if (!name || !email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        alert("Enter a valid name and email address!");
        return;
    }

    localStorage.setItem("sp_profile", JSON.stringify({name,email}));
    $("welcome").textContent = "Welcome, " + name + "! 👋";
    $("profileMessage").textContent = "Profile saved successfully!";
}

/* SECURITY: DISPLAY USER TEXT AS TEXT */

function escapeHTML(value) {
    return String(value).replace(/[&<>"']/g, char => ({
        "&": "&amp;",
        "<": "&lt;",
        ">": "&gt;",
        '"': "&quot;",
        "'": "&#39;"
    })[char]);
}

/* INITIALIZE */

function renderAll() {
    renderTasks();
    renderHabits();
    renderGoals();
    renderStats();
}

function initialize() {
    const profile = readData("sp_profile", null);

    if (profile) {
        $("userName").value = profile.name || "";
        $("userEmail").value = profile.email || "";
        $("welcome").textContent =
            "Welcome, " + profile.name + "! 👋";
    }

    renderCalendar();
    updateTimer();
    renderAll();

    const plans = readData("sp_plans", {});
    $("plannerText").value = plans[today()] || "";

    const journal = readData("sp_journal", {});
    $("journalText").value = journal[today()] || "";
}

initialize();

</script>

</body>
</html>
